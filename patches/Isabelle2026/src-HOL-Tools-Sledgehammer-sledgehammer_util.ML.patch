 fun thms_of_name ctxt name =
-  let
-    val keywords = Thy_Header.get_keywords' ctxt
-  in
-    Token.explode keywords Position.start name
-    |> filter Token.is_proper
-    |> Source.of_list
-    |> Source.source' (Context.Proof ctxt) Token.stopper Attrib.multi_thm
