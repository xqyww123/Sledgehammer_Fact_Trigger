+  in implode (text toks) end
+
+(*name(i)[attributes] for the k-th theorem of an argument that yields several theorems: i is its
+  index in the whole fact, which is the value of the name token*)
+fun name_of_nth ths toks k =
+  \<^try>\<open>
+    let
+      val name_tok :: toks' = toks
+      val SOME (Token.Fact (_, whole)) = Token.get_value name_tok
+      val (selection, attrib_toks) = Scan.finite Token.stopper (Scan.option Parse.thm_sel) toks'
+      val indexes =
+        (case selection of
+          NONE => 1 upto length ths
+        | SOME intervals => Try0_Util.indexes_of_selection (length whole) intervals)
+    in
+      Token.unparse name_tok ^
+      Facts.string_of_selection (SOME [Facts.Single (nth indexes k)]) ^
+      text_of_tokens attrib_toks
+    end
+    catch _ => text_of_tokens toks ^ enclose "(" ")" (string_of_int (k + 1))\<close>
+
+(*the name that the name hint gives, if it denotes this very theorem in the context*)
+fun name_of_hint ctxt th =
+  \<^try>\<open>
+    let
+      val (name, i) = Thm.get_name_hint th
+      val xref =
+        Facts.Named ((#2 (Proof_Context.markup_extern_fact ctxt name), Position.none),
+          if i = 0 then NONE else SOME [Facts.Single i])
+    in
+      (case Proof_Context.get_fact ctxt xref of
+        [th'] =>
+          if Thm.eq_thm (th, th') then SOME (Try0_Util.string_of_xref' ctxt (xref, [])) else NONE
+      | _ => NONE)
+    end
+    catch _ => NONE\<close>
