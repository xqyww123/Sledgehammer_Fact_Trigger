 fun weight_facts_steeply facts = map_index (swap o apfst steep_weight_of_fact) facts
 
+(* Facts generated by MePo's fact triggers are unknown to the other fact filters. *)
+fun mesh_facts_with_mepo ctxt max_facts (mepo_weight, mepo_facts) mess =
+  let
+    val generated = map_filter (fn (fact, From_Trigger) => SOME fact | _ => NONE) mepo_facts
+    val mepo = (mepo_weight, (weight_facts_steeply (map fst mepo_facts), []))
+    val mess = map (apsnd (apsnd (fn unks => unks @ generated))) mess
+  in
+    mesh_facts (fact_distinct (op aconv)) (eq_snd (gen_eq_thm ctxt)) max_facts (mepo :: mess)
+  end
+
+(* Inserts each generated fact at its MePo index. *)
+fun insert_generated_facts mepo_facts =
+  let
+    fun insert (i, (fact, From_Trigger)) facts =
+        let val (bef, after) = chop i facts
+        in bef @ fact :: after end
+      | insert _ facts = facts
+  in
+    fold_index insert mepo_facts
+  end
